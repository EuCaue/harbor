# Global defaults. All watched folders inherit these.
# Env vars ($VAR or ${VAR}) expand in `path` and `to`. Missing stay literal.
# First matching rule wins.
[defaults]
to = "$HOME/Downloads/organized"
mode = "move"              # move | copy
wait = 5                   # wait stable file size (skip active downloads)
overwrite = false          # false = collision renames to name_1.ext, name_2.ext...
include_dirs = false       # true = also process and move directories

[ignore]
match = ["*.part", "*.crdownload", "*.tmp", ".*"]

# ------------------------------------------------------------
# Watched folders. Always [[folder]], even if just one.
# ------------------------------------------------------------

[[folder]]
path = "$HOME/Downloads"

  [folder.options]         # override global per-field
  wait = 15

  [folder.ignore]          # appends to global ignore
  match = ["*.srt"]

  [[folder.rule]]
  name = "Photos"          # optional log label
  match = "*.{jpg,png,gif,webp}"
  to = "$HOME/Pictures"

  [[folder.rule]]
  match = "*.{pdf,epub,djvu}"
  to = "$HOME/Documents"

  [[folder.rule]]
  match = "*.{zip,tar.gz,7z}"
  to = "$HOME/Archives"

  [[folder.rule]]          # fallback catch-all
  match = "*"
  to = "$HOME/Downloads/organized"

[[folder]]
path = "$HOME/work/inbox"

  [folder.options]
  mode = "copy"            # keep inbox full
  overwrite = true         # overwrite on collision

  [folder.ignore]
  match = ["*.pending"]

  [[folder.rule]]
  match = "invoice-*"
  to = "$HOME/work/invoices"

  [[folder.rule]]
  match = "*"
  to = "$HOME/work/misc"

[[folder]]
path = "/mnt/usb/phone-dump"

  [folder.options]
  wait = 0                 # usb copy done; move now

  [[folder.rule]]
  match = "*"
  to = "$HOME/Phone"

# ------------------------------------------------------------
# Minimum setup: one folder, zero rules -> all to global 'to'
# ------------------------------------------------------------
# [[folder]]
# path = "$HOME/Downloads"
